# Pulsegram Environment Variables
# Copy to .env.local (web) — NEVER commit real secrets

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Pulsegram
NEXT_PUBLIC_PACKAGE_NAME=com.gram.pulse

# Firebase (project: viewtube-v2 — package com.gram.pulse already registered)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDwGJ6sr5yS-Chqkuk1gA9BdkRdeMlhxsM
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=viewtube-v2.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=viewtube-v2
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=viewtube-v2.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=225740234992
NEXT_PUBLIC_FIREBASE_APP_ID=1:225740234992:web:YOUR_WEB_APP_ID
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://viewtube-v2-default-rtdb.asia-southeast1.firebasedatabase.app

# Server-only Firebase Admin (Cloud Functions / Next.js API routes)
FIREBASE_ADMIN_PROJECT_ID=viewtube-v2
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=

# WebRTC ICE
NEXT_PUBLIC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional production TURN (strongly recommended)
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Optional Cloudinary for advanced media processing
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
