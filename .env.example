# Pulsegram Environment Variables
# Copy to .env.local and fill in real values. NEVER commit .env.local

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Pulsegram

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WebRTC / ICE
NEXT_PUBLIC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional production TURN (recommended)
# TURN_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Optional media processing
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional push (FCM)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# FIREBASE_SERVER_KEY=

# Admin
# ADMIN_EMAILS=admin@example.com
